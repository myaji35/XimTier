#!/usr/bin/env bash
# deploy.yml 이 요구하는 시크릿이 GitHub Secrets 에 실제로 등록돼 있는지 확인한다.
#
# 배경(XIM-22): 시크릿 주입 경로가 둘이다.
#   로컬 실행 → .kamal/secrets  |  배포 → GitHub Secrets
# .kamal/secrets 는 gitignore 라 러너에 없다. 로컬 파일만 고치면 배포는 빈 값으로 나가고,
# Rails 는 조용히 폴백한다(예: SMTP 미설정 시 delivery_method=:test → 메일을 버림).
# 배포 전에 이 스크립트로 누락을 잡는다.
#
# 사용: bin/check-deploy-secrets

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

command -v gh >/dev/null 2>&1 || { echo "gh CLI 가 필요하다" >&2; exit 2; }

# repo 레벨 + environment 레벨을 모두 모은다.
# RAILS_MASTER_KEY 등은 environment(production/staging) 레벨에만 있어서
# repo 레벨만 보면 "미등록"으로 오판한다.
REPO_SECRETS=$(gh secret list --json name --jq '.[].name' 2>/dev/null) || {
  echo "GitHub Secrets 조회 실패 — gh auth status 확인" >&2; exit 2; }
ENV_SECRETS=""
for e in $(gh api repos/{owner}/{repo}/environments --jq '.environments[].name' 2>/dev/null); do
  ENV_SECRETS="$ENV_SECRETS
$(gh api "repos/{owner}/{repo}/environments/$e/secrets" --jq '.secrets[].name' 2>/dev/null)"
done
REGISTERED=$(printf '%s\n%s\n' "$REPO_SECRETS" "$ENV_SECRETS" | grep -v '^$' | sort -u)

# deploy.yml 이 workflow env 로 넘기는 secrets.* 이름을 뽑는다
WANTED=$(grep -oE '\$\{\{ *secrets\.[A-Z_]+ *\}\}' .github/workflows/deploy.yml \
         | grep -oE '[A-Z_]{3,}' | grep -v '^SECRETS$' | sort -u)

missing=0
echo "deploy.yml 이 참조하는 시크릿 점검:"
while read -r name; do
  [ -z "$name" ] && continue
  if grep -qx "$name" <<<"$REGISTERED"; then
    printf "  ✓ %s\n" "$name"
  else
    printf "  ✗ %s  ← 미등록. 배포 시 빈 값이 된다\n" "$name"
    missing=$((missing+1))
  fi
done <<<"$WANTED"

echo
if [ "$missing" -gt 0 ]; then
  echo "미등록 ${missing}건. 등록: gh secret set <NAME>"
  echo "※ 선택 항목(SENTRY_DSN 등)은 비워도 앱이 자동 비활성화한다 — 의도한 것이면 무시."
  exit 1
fi
echo "전부 등록됨."
