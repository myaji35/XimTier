<% content_for :title, t("email_opt_outs.show.title") %>

<section class="surface-canvas section-pad">
  <div class="wrap" style="max-width:640px;">
    <p class="type-uppercase-tag text-rausch"><%= t("email_opt_outs.eyebrow") %></p>
    <h1 class="type-display-xl mt-3"><%= t("email_opt_outs.show.title") %></h1>
    <p class="type-body-md text-body-airbnb mt-5">
      <%= t("email_opt_outs.show.description", email: masked_email(@email)) %>
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <%= link_to t("email_opt_outs.show.cancel"), home_path(locale: I18n.locale), class: "btn-secondary" %>
      <%= button_to t("email_opt_outs.show.confirm"), unsubscribe_path(locale: I18n.locale),
            params: { token: @token }, method: :post, class: "btn-rausch", style: "cursor:pointer;" %>
    </div>
  </div>
</section>
