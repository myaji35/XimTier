<% content_for :title, t("devise.unlocks.new.resend_unlock_instructions") %>

<section class="section-pad"><div class="wrap" style="max-width:640px;">
  <h1 class="h-section"><%= t("devise.unlocks.new.resend_unlock_instructions") %></h1>
  <p class="lead mt-3"><%= t("devise.unlocks.new.lead") %></p>
  <div class="card-airbnb mt-8 p-7">
    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div>
        <%= f.label :email, t("devise.shared.email"), class: "block type-body-sm font-semibold mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 rounded-[10px] border-hairline type-body-md" %>
      </div>
      <%= f.submit t("devise.unlocks.new.resend_unlock_instructions"), class: "btn-rausch", data: { turbo_submits_with: t("devise.shared.processing") } %>
    <% end %>
  </div>
  <%= render "devise/shared/links" %>
</div></section>
