<% content_for :title, t("devise.registrations.edit.title") %>

<section class="section-pad">
  <div class="wrap" style="max-width:640px;">
    <h1 class="h-section"><%= t("devise.registrations.edit.title") %></h1>
    <p class="lead mt-3"><%= t("devise.registrations.edit.lead") %></p>

    <div class="card-airbnb mt-8 p-7">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div>
          <%= f.label :email, t("devise.shared.email"), class: "block type-body-sm font-semibold mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 rounded-[10px] border-hairline type-body-md" %>
        </div>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="type-body-md"><%= t("devise.registrations.edit.currently_waiting_confirmation_for_email", email: resource.unconfirmed_email) %></p>
        <% end %>
        <div>
          <%= f.label :password, t("devise.shared.new_password"), class: "block type-body-sm font-semibold mb-2" %>
          <p class="type-body-md mb-2"><%= t("devise.registrations.edit.leave_blank_if_you_don_t_want_to_change_it") %></p>
          <% if @minimum_password_length %>
            <p class="type-body-md mb-2"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-3 rounded-[10px] border-hairline type-body-md" %>
        </div>
        <div>
          <%= f.label :password_confirmation, t("devise.shared.password_confirmation"), class: "block type-body-sm font-semibold mb-2" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-3 rounded-[10px] border-hairline type-body-md" %>
        </div>
        <div>
          <%= f.label :current_password, t("devise.shared.current_password"), class: "block type-body-sm font-semibold mb-2" %>
          <p class="type-body-md mb-2"><%= t("devise.registrations.edit.we_need_your_current_password_to_confirm_your_changes") %></p>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-4 py-3 rounded-[10px] border-hairline type-body-md" %>
        </div>
        <%= f.submit t("devise.registrations.edit.update"), class: "btn-rausch", data: { turbo_submits_with: t("devise.shared.processing") } %>
      <% end %>
    </div>

    <div class="card-airbnb mt-8 p-7">
      <h2 class="h-section"><%= t("devise.registrations.edit.cancel_my_account") %></h2>
      <p class="type-body-md mt-3"><%= t("devise.registrations.edit.unhappy") %></p>
      <div class="mt-5">
        <%= button_to t("devise.registrations.edit.cancel_my_account"), registration_path(resource_name), method: :delete, class: "btn-rausch", data: { turbo_confirm: t("devise.registrations.edit.are_you_sure") } %>
      </div>
    </div>
    <p class="type-body-md mt-6"><%= link_to t("devise.shared.links.back"), :back %></p>
  </div>
</section>
