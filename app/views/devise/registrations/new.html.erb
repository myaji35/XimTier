<% content_for :title, t("devise.registrations.new.sign_up") %>

<section class="section-pad">
  <div class="wrap" style="max-width:640px;">
    <h1 class="h-section"><%= t("devise.registrations.new.sign_up") %></h1>
    <p class="lead mt-3"><%= t("devise.shared.sign_up_lead") %></p>

    <div class="card-airbnb mt-8 p-7">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div>
          <%= f.label :email, t("devise.shared.email"), class: "block type-body-sm font-semibold mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 rounded-[10px] border-hairline type-body-md" %>
        </div>
        <div>
          <%= f.label :password, t("devise.shared.password"), class: "block type-body-sm font-semibold mb-2" %>
          <% if @minimum_password_length %>
            <p class="type-body-md mb-2"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-3 rounded-[10px] border-hairline type-body-md" %>
        </div>
        <div>
          <%= f.label :password_confirmation, t("devise.shared.password_confirmation"), class: "block type-body-sm font-semibold mb-2" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-3 rounded-[10px] border-hairline type-body-md" %>
        </div>
        <%= f.submit t("devise.registrations.new.sign_up"), class: "btn-rausch", data: { turbo_submits_with: t("devise.shared.processing") } %>
      <% end %>
    </div>
    <%= render "devise/shared/links" %>
  </div>
</section>
