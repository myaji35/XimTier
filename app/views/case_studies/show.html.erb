<% content_for :title, "#{@case.title} — #{t('site.brand')}" %>
<% content_for :description, @case.summary %>
<% og_image = if @case.hero_image.attached?
                "#{request.base_url}#{url_for(@case.hero_image)}"
              elsif (youtube_id = @media.detect(&:youtube?)&.youtube_id)
                "https://i.ytimg.com/vi/#{youtube_id}/hqdefault.jpg"
              else
                "#{request.base_url}/og-image.png"
              end %>
<% content_for :meta_og_image, og_image %>
<% set_meta_tags og: { type: "article", image: og_image }, article: { published_time: @case.published_at&.iso8601 } %>

<article class="surface-canvas section-pad">
  <div class="wrap" style="max-width:860px;">
    <%# 헤더 %>
    <div class="mb-2">
      <%= link_to "← #{t('cases_gallery.back', default: '사례 목록')}", case_studies_path(locale: I18n.locale),
            class: "type-body-sm text-muted-airbnb hover:text-rausch" %>
    </div>
    <% if @case.industry.present? %>
      <div class="font-mono type-uppercase-tag text-rausch">// <%= @case.industry.upcase %></div>
    <% end %>
    <h1 class="type-display-xl mt-2"><%= @case.title %></h1>
    <div class="mt-3 flex items-center type-body-sm text-muted-airbnb" style="gap:14px;">
      <span><%= l(@case.published_at.to_date, format: :long) if @case.published_at %></span>
      <span class="flex items-center" style="gap:5px;">
        <%= render IconComponent.new(name: "heart", size: 15) %>
        <span data-likes-target="count"><%= @case.likes_count %></span>
      </span>
    </div>
    <% if @case.summary.present? %>
      <p class="type-body-md text-body-airbnb mt-5" style="line-height:1.7;"><%= @case.summary %></p>
    <% end %>

    <%# 미디어 룸 — 유튜브 / PDF / HTML %>
    <% @media.each do |m| %>
      <section class="mt-10">
        <% if m.title.present? %>
          <h2 class="type-display-sm mb-3"><%= m.title %></h2>
        <% end %>

        <% if m.youtube? && m.youtube_embed_url %>
          <div class="relative w-full rounded-xl overflow-hidden" style="aspect-ratio:16/9;background:#000;">
            <iframe src="<%= m.youtube_embed_url %>" title="<%= m.title || @case.title %>"
                    loading="lazy" allowfullscreen
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
          </div>

        <% elsif m.pdf? && m.pdf.attached? %>
          <div class="rounded-xl overflow-hidden border-hairline" style="height:80vh;max-height:900px;">
            <iframe src="<%= url_for(m.pdf) %>#view=FitH" title="<%= m.title || 'PDF' %>"
                    style="width:100%;height:100%;border:0;"></iframe>
          </div>
          <div class="mt-2">
            <%= link_to "↓ #{t('cases_gallery.download_pdf', default: 'PDF 내려받기')}", url_for(m.pdf),
                  class: "type-body-sm text-rausch hover:underline", target: "_blank", rel: "noopener" %>
          </div>

        <% elsif m.html? && m.embed_html.present? %>
          <div class="case-html-body type-body-md text-body-airbnb" style="line-height:1.7;">
            <%= sanitize m.embed_html,
                  tags: %w[p br a ul ol li strong em b i h2 h3 h4 blockquote code pre table thead tbody tr th td img figure figcaption hr span div],
                  attributes: %w[href src alt title class colspan rowspan target rel] %>
          </div>
        <% end %>

        <% if m.caption.present? %>
          <p class="type-body-sm text-muted-airbnb mt-3"><%= m.caption %></p>
        <% end %>
      </section>
    <% end %>

    <%# 본문 설명(HTML) %>
    <% if @case.body_html.present? %>
      <section class="mt-10 case-html-body type-body-md text-body-airbnb" style="line-height:1.7;">
        <%= sanitize @case.body_html,
              tags: %w[p br a ul ol li strong em b i h2 h3 h4 blockquote code pre table thead tbody tr th td img figure figcaption hr span div],
              attributes: %w[href src alt title class colspan rowspan target rel] %>
      </section>
    <% end %>

    <%# 좋아요 %>
    <div class="mt-12 pt-8 border-t border-hairline flex items-center" style="gap:12px;"
         data-controller="likes"
         data-likes-url-value="<%= case_like_path(locale: I18n.locale, slug: @case.slug) %>"
         data-likes-liked-value="<%= @liked %>">
      <button type="button" data-action="likes#toggle" data-likes-target="button"
              class="btn-rausch #{@liked ? '' : 'is-outline'}"
              style="padding:10px 20px;font-size:14px;min-height:auto;display:inline-flex;align-items:center;gap:8px;<%= @liked ? '' : 'background:transparent;color:var(--color-rausch);border:1px solid var(--color-rausch);' %>">
        <%= render IconComponent.new(name: "heart", size: 16) %>
        <span data-likes-target="label"><%= @liked ? t("cases_gallery.liked", default: "좋아요 취소") : t("cases_gallery.like", default: "좋아요") %></span>
      </button>
      <div data-controller="share"
           data-share-share-value="<%= t('cases_gallery.share') %>"
           data-share-done-value="<%= t('cases_gallery.share_done') %>">
        <button type="button" data-action="share#copy"
                class="btn-rausch is-outline"
                style="padding:10px 20px;font-size:14px;min-height:auto;display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--color-rausch);border:1px solid var(--color-rausch);">
          <%= render IconComponent.new(name: "link", size: 16) %>
          <span data-share-target="label"><%= t("cases_gallery.share") %></span>
        </button>
      </div>
      <span class="type-body-sm text-muted-airbnb"><span data-likes-target="count"><%= @case.likes_count %></span> <%= t("cases_gallery.likes_unit", default: "명이 좋아합니다") %></span>
    </div>

    <%# 댓글 %>
    <section class="mt-12">
      <h2 class="type-display-sm mb-5"><%= t("cases_gallery.comments", default: "댓글") %> <span class="text-muted-airbnb">(<%= @comments.size %>)</span></h2>

      <%= form_with url: case_comments_path(locale: I18n.locale, slug: @case.slug), method: :post, class: "mb-8" do |f| %>
        <%= f.fields_for :case_comment do |c| %>
          <div class="grid grid-cols-1 sm:grid-cols-[200px_1fr]" style="gap:10px;">
            <%= c.text_field :author_name, placeholder: t("cases_gallery.name_ph", default: "이름"), required: true,
                  class: "px-3 py-2 rounded-lg border-hairline type-body-sm", style: "border:1px solid var(--color-hairline,#ddd);" %>
            <%= c.text_area :body, placeholder: t("cases_gallery.comment_ph", default: "댓글을 입력하세요 (검토 후 게시됩니다)"), required: true, rows: 2,
                  class: "px-3 py-2 rounded-lg type-body-sm", style: "border:1px solid var(--color-hairline,#ddd);" %>
          </div>
        <% end %>
        <div class="mt-3">
          <%= f.submit t("cases_gallery.comment_submit", default: "댓글 등록"),
                class: "btn-rausch", style: "padding:9px 20px;font-size:13px;min-height:auto;cursor:pointer;" %>
        </div>
      <% end %>

      <% if @comments.any? %>
        <ul class="space-y-4">
          <% @comments.each do |cm| %>
            <li class="p-4 rounded-lg" style="background:var(--color-surface-soft,#f7f7f7);">
              <div class="flex items-center justify-between">
                <span class="type-body-sm font-semibold text-ink-airbnb"><%= cm.author_name %></span>
                <span class="type-body-sm text-muted-airbnb"><%= l(cm.created_at, format: :short) %></span>
              </div>
              <p class="type-body-sm text-body-airbnb mt-2" style="line-height:1.6;white-space:pre-wrap;"><%= cm.body %></p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="type-body-sm text-muted-airbnb"><%= t("cases_gallery.no_comments", default: "첫 번째 댓글을 남겨보세요.") %></p>
      <% end %>
    </section>
  </div>
</article>
