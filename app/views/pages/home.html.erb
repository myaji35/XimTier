<% content_for :title, "#{t('site.brand')} — #{t('site.positioning')}" %>

<%= render "shared/mini_nav" %>

<div class="v3-root">

<style>
/* ─── v3 Design Tokens ─────────────────────────────────────────── */
.v3-root {
  --c-rausch:   #ff385c;
  --c-canvas:   #ffffff;
  --c-ink:      #222222;
  --c-body:     #3f3f3f;
  --c-muted:    #6a6a6a;
  --c-hairline: #dddddd;
  --c-navy:     #0a1124;
  --c-navy2:    #16325c;
  --c-teal:     #00c8c8;
  --c-blue:     #2563eb;
  --grad-teal: linear-gradient(135deg, #2563eb, #00c8c8);
  --font-sans:  'Airbnb Cereal VF', Circular, Inter, system-ui, 'Apple SD Gothic Neo', sans-serif;
  --font-mono:  'JetBrains Mono', ui-monospace, monospace;
  font-family: var(--font-sans);
  color: var(--c-body);
}

/* ─── Utilities ────────────────────────────────────────────────── */
.v3-wrap {
  max-width: 1160px;
  margin: 0 auto;
  padding: 0 24px;
}
.v3-eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--c-teal);
  margin-bottom: 16px;
}
.v3-grad-text {
  background: var(--grad-teal);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ─── Hero (Dark Navy) ─────────────────────────────────────────── */
.v3-hero {
  background: var(--c-navy);
  padding: 120px 0 80px;
  position: relative;
  overflow: hidden;
}
.v3-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(900px 600px at 80% 20%, rgba(0,200,200,0.12), transparent 60%),
    radial-gradient(700px 500px at 5% 90%, rgba(37,99,235,0.18), transparent 60%);
  pointer-events: none;
}
.v3-hero__inner {
  position: relative;
}
.v3-hero__headline {
  font-size: clamp(28px, 4.2vw, 52px);
  font-weight: 700;
  line-height: 1.22;
  color: #fff;
  word-break: keep-all;
  margin: 0 0 20px;
  max-width: 700px;
}
.v3-hero__sub {
  font-size: 17px;
  line-height: 1.7;
  color: #a7b1c7;
  max-width: 560px;
  margin: 0 0 40px;
  word-break: keep-all;
}
.v3-btn-primary {
  display: inline-block;
  padding: 16px 32px;
  background: var(--c-rausch);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  border-radius: 10px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.15s;
  box-shadow: 0 10px 28px -6px rgba(255,56,92,0.45);
}
.v3-btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }
.v3-btn-ghost {
  display: inline-block;
  padding: 15px 28px;
  background: transparent;
  color: #a7b1c7;
  font-size: 15px;
  font-weight: 600;
  border-radius: 10px;
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.18);
  transition: border-color 0.15s, color 0.15s;
}
.v3-btn-ghost:hover { border-color: rgba(255,255,255,0.45); color: #fff; }
.v3-hero__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 60px;
}

/* 6-Step Workflow ─────────────────────────────────────────────── */
.v3-workflow {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
  margin-bottom: 32px;
}
@media (max-width: 1040px) { .v3-workflow { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 620px)  { .v3-workflow { grid-template-columns: repeat(2, 1fr); } }

.v3-step {
  background: rgba(255,255,255,0.045);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 14px;
  padding: 20px 16px;
  position: relative;
}
.v3-step__num {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  color: var(--c-teal);
  margin-bottom: 10px;
}
.v3-step__title {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
  margin-bottom: 6px;
  word-break: keep-all;
}
.v3-step__desc {
  font-size: 11.5px;
  color: #7a8aab;
  line-height: 1.5;
  word-break: keep-all;
}

.v3-hero__footer-note {
  font-size: 13px;
  color: #5a6880;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,0.07);
  word-break: keep-all;
}
.v3-hero__footer-note strong {
  color: var(--c-teal);
  font-weight: 600;
}

/* ─── Section Common ───────────────────────────────────────────── */
.v3-section {
  padding: 100px 0;
}
.v3-section--alt {
  background: #f7f8fa;
}
.v3-section--dark {
  background: var(--c-navy);
  color: #fff;
}
.v3-section__title {
  font-size: clamp(24px, 3vw, 38px);
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.25;
  margin: 0 0 16px;
  word-break: keep-all;
}
.v3-section--dark .v3-section__title { color: #fff; }
.v3-section__lead {
  font-size: 16px;
  line-height: 1.75;
  color: var(--c-muted);
  max-width: 600px;
  word-break: keep-all;
}
.v3-section--dark .v3-section__lead { color: #a7b1c7; }

/* ─── Reverse What-If ──────────────────────────────────────────── */
.v3-reverse__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
@media (max-width: 820px) { .v3-reverse__grid { grid-template-columns: 1fr; gap: 36px; } }
.v3-reverse__diagram {
  background: var(--c-navy);
  border-radius: 20px;
  padding: 36px 32px;
  position: relative;
  overflow: hidden;
}
.v3-reverse__diagram::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(600px 400px at 80% 20%, rgba(0,200,200,0.1), transparent 60%);
  pointer-events: none;
}
.v3-reverse__diagram-inner { position: relative; }
.v3-diagram-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
}
.v3-diagram-label {
  font-size: 12px;
  font-family: var(--font-mono);
  color: #7a8aab;
  width: 36px;
  flex-shrink: 0;
}
.v3-diagram-pill {
  flex: 1;
  padding: 10px 16px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
}
.v3-diagram-pill--goal {
  background: rgba(37,99,235,0.2);
  border: 1px solid rgba(37,99,235,0.4);
  color: #93c5fd;
}
.v3-diagram-pill--result {
  background: rgba(0,200,200,0.12);
  border: 1px solid rgba(0,200,200,0.3);
  color: var(--c-teal);
}
.v3-diagram-arrow {
  display: flex;
  justify-content: center;
  margin-bottom: 14px;
}
.v3-diagram-arrow svg { color: #4a5568; }
.v3-reverse__title-block .accent { color: var(--c-ink); }

/* ─── Architecture ─────────────────────────────────────────────── */
.v3-arch-stack {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-top: 48px;
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
}
.v3-arch-layer {
  border-radius: 14px;
  padding: 28px 32px;
  display: grid;
  grid-template-columns: 60px 1fr 1fr;
  gap: 16px;
  align-items: center;
  text-decoration: none;
  transition: transform 0.15s, box-shadow 0.15s;
}
.v3-arch-layer:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0,0,0,0.28); }
@media (max-width: 600px) { .v3-arch-layer { grid-template-columns: 1fr; } }
.v3-arch-layer--top  { background: #1e2a4a; border: 1px solid rgba(37,99,235,0.3); }
.v3-arch-layer--core { background: #132640; border: 1px solid rgba(0,200,200,0.3); }
.v3-arch-layer--base { background: #0d1c32; border: 1px solid rgba(255,255,255,0.08); }
.v3-arch-tier {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--c-teal);
}
.v3-arch-name {
  font-size: 17px;
  font-weight: 700;
  color: #fff;
}
.v3-arch-subtitle {
  font-size: 12px;
  color: #7a8aab;
  margin-top: 2px;
}
.v3-arch-desc {
  font-size: 13px;
  color: #8a94ac;
  line-height: 1.55;
  word-break: keep-all;
}

/* ─── Solutions ────────────────────────────────────────────────── */
.v3-solutions-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  margin-top: 48px;
}
@media (max-width: 1000px) { .v3-solutions-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 620px)  { .v3-solutions-grid { grid-template-columns: repeat(2, 1fr); } }
.v3-sol-card {
  display: block;
  text-decoration: none;
  background: var(--c-canvas);
  border: 1px solid var(--c-hairline);
  border-radius: 14px;
  padding: 22px 18px;
  transition: box-shadow 0.15s, transform 0.15s, border-color 0.15s;
}
.v3-sol-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.08); transform: translateY(-2px); border-color: rgba(0,200,200,0.45); }
.v3-sol-idx {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--c-teal);
  font-weight: 700;
  letter-spacing: 0.1em;
  margin-bottom: 8px;
}
.v3-sol-name {
  font-size: 13px;
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.45;
  word-break: keep-all;
}

/* ─── Versus ───────────────────────────────────────────────────── */
.v3-versus-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 48px;
  font-size: 14px;
}
.v3-versus-table th {
  padding: 14px 16px;
  text-align: left;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--c-muted);
  border-bottom: 2px solid var(--c-hairline);
}
.v3-versus-table th:nth-child(2) { color: var(--c-blue); }
.v3-versus-table td {
  padding: 14px 16px;
  border-bottom: 1px solid var(--c-hairline);
  vertical-align: middle;
  word-break: keep-all;
}
.v3-versus-table td:first-child { font-weight: 600; color: var(--c-ink); }
.v3-versus-table td:nth-child(2) {
  font-weight: 700;
  color: var(--c-blue);
  background: rgba(37,99,235,0.04);
}
.v3-versus-table tr:last-child td { border-bottom: none; }
@media (max-width: 820px) {
  .v3-versus-table { font-size: 12px; }
  .v3-versus-table th, .v3-versus-table td { padding: 10px 10px; }
  .v3-versus-table th:nth-child(n+5), .v3-versus-table td:nth-child(n+5) { display: none; }
}

/* ─── CTA ──────────────────────────────────────────────────────── */
.v3-cta {
  background: var(--c-navy);
  padding: 100px 0;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.v3-cta::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(700px 400px at 30% 50%, rgba(37,99,235,0.18), transparent 60%),
    radial-gradient(600px 350px at 75% 50%, rgba(0,200,200,0.13), transparent 60%);
  pointer-events: none;
}
.v3-cta__inner { position: relative; }
.v3-cta__title {
  font-size: clamp(24px, 3.5vw, 44px);
  font-weight: 700;
  color: #fff;
  margin: 0 0 36px;
  word-break: keep-all;
  line-height: 1.25;
}
.v3-cta__btns {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  justify-content: center;
}
</style>

<%# ═══════════════════════════════════════════════════════════════ %>
<%# SECTION 1 — HERO (Dark Navy, Slide 5)                          %>
<%# ═══════════════════════════════════════════════════════════════ %>
<section class="v3-hero">
  <div class="v3-wrap v3-hero__inner">

    <div class="v3-eyebrow">핵심 기술력 · AI Decision Intelligence</div>

    <h1 class="v3-hero__headline">
      <%= t("v3.hero.headline") %>
    </h1>

    <p class="v3-hero__sub"><%= t("v3.hero.sub") %></p>

    <div class="v3-hero__ctas">
      <%= link_to t("v3.hero.cta_demo"),    demo_path(locale: I18n.locale),    class: "v3-btn-primary" %>
      <%= link_to t("v3.hero.cta_contact"), contact_path(locale: I18n.locale), class: "v3-btn-ghost" %>
    </div>

    <%# 6-Step Workflow %>
    <div class="v3-workflow">
      <% t("v3.hero.steps").each do |step| %>
        <div class="v3-step">
          <div class="v3-step__num"><%= step[:n] %></div>
          <div class="v3-step__title"><%= step[:title] %></div>
          <div class="v3-step__desc"><%= step[:desc] %></div>
        </div>
      <% end %>
    </div>

    <div class="v3-hero__footer-note">
      <strong>Ximtier</strong> — <%= t("v3.hero.footer_note") %>
    </div>

  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════ %>
<%# SECTION 2 — Reverse What-If                                     %>
<%# ═══════════════════════════════════════════════════════════════ %>
<section class="v3-section">
  <div class="v3-wrap">
    <div class="v3-reverse__grid">

      <%# Left: text %>
      <div>
        <div class="v3-eyebrow" style="color: var(--c-blue);">
          <%= t("v3.reverse.eyebrow") %>
        </div>
        <h2 class="v3-section__title">
          <%= t("v3.reverse.title") %><br>
          <span class="v3-grad-text"><%= t("v3.reverse.title_accent") %></span>
        </h2>
        <p class="v3-section__lead" style="margin-top:16px;">
          <%= t("v3.reverse.lead") %>
        </p>
      </div>

      <%# Right: diagram %>
      <div class="v3-reverse__diagram">
        <div class="v3-reverse__diagram-inner">

          <div class="v3-diagram-row">
            <div class="v3-diagram-label">GOAL</div>
            <div class="v3-diagram-pill v3-diagram-pill--goal">
              <% if I18n.locale.to_s == "ko" %>
                불량률 1.2% 이하
              <% else %>
                Defect rate ≤ 1.2%
              <% end %>
            </div>
          </div>

          <div class="v3-diagram-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
          </div>

          <div style="font-family: var(--font-mono); font-size: 11px; color: #5a6880; margin-bottom: 10px;">
            Reverse What-If →
          </div>

          <div class="v3-diagram-row">
            <div class="v3-diagram-label">X₁</div>
            <div class="v3-diagram-pill v3-diagram-pill--result">
              <% if I18n.locale.to_s == "ko" %>
                온도 215°C → 207°C
              <% else %>
                Temp 215°C → 207°C
              <% end %>
            </div>
          </div>
          <div class="v3-diagram-row">
            <div class="v3-diagram-label">X₂</div>
            <div class="v3-diagram-pill v3-diagram-pill--result">
              <% if I18n.locale.to_s == "ko" %>
                압력 3.2bar → 2.8bar
              <% else %>
                Pressure 3.2bar → 2.8bar
              <% end %>
            </div>
          </div>
          <div class="v3-diagram-row">
            <div class="v3-diagram-label">X₃</div>
            <div class="v3-diagram-pill v3-diagram-pill--result">
              <% if I18n.locale.to_s == "ko" %>
                속도 12m/min → 10.5m/min
              <% else %>
                Speed 12m/min → 10.5m/min
              <% end %>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════ %>
<%# SECTION 3 — 3-Tier Architecture                                 %>
<%# ═══════════════════════════════════════════════════════════════ %>
<section class="v3-section v3-section--dark">
  <div class="v3-wrap">
    <div class="v3-eyebrow"><%= t("v3.arch.eyebrow") %></div>
    <h2 class="v3-section__title"><%= t("v3.arch.title") %></h2>

    <div class="v3-arch-stack">
      <% arch_slugs = ["arch_top", "arch_core", "arch_base"] %>
      <% t("v3.arch.layers").each_with_index do |layer, i| %>
        <% tier_class = ["top","core","base"][i] %>
        <%= link_to v3_detail_path(slug: arch_slugs[i], locale: I18n.locale), class: "v3-arch-layer v3-arch-layer--#{tier_class}" do %>
          <div class="v3-arch-tier"><%= layer[:tier] %></div>
          <div>
            <div class="v3-arch-name"><%= layer[:name] %></div>
            <div class="v3-arch-subtitle"><%= layer[:subtitle] %></div>
          </div>
          <div class="v3-arch-desc"><%= layer[:desc] %></div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════ %>
<%# SECTION 4 — 10 Industry Solutions                               %>
<%# ═══════════════════════════════════════════════════════════════ %>
<section class="v3-section v3-section--alt">
  <div class="v3-wrap">
    <div class="v3-eyebrow"><%= t("v3.solutions.eyebrow") %></div>
    <h2 class="v3-section__title" style="color: var(--c-ink);"><%= t("v3.solutions.title") %></h2>

    <div class="v3-solutions-grid">
      <% sol_slugs = %w[sol_meeting sol_survey sol_sns sol_festival sol_market sol_store sol_clinic sol_maintenance sol_sns_product sol_survey_product] %>
      <% t("v3.solutions.items").each_with_index do |item, i| %>
        <%= link_to v3_detail_path(slug: sol_slugs[i], locale: I18n.locale), class: "v3-sol-card" do %>
          <div class="v3-sol-idx"><%= sprintf("%02d", i + 1) %></div>
          <div class="v3-sol-name"><%= item %></div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════ %>
<%# SECTION 5 — Competitor Comparison                               %>
<%# ═══════════════════════════════════════════════════════════════ %>
<section class="v3-section">
  <div class="v3-wrap">
    <div class="v3-eyebrow"><%= t("v3.versus.eyebrow") %></div>
    <h2 class="v3-section__title"><%= t("v3.versus.title") %></h2>

    <div style="overflow-x: auto; margin-top: 0;">
      <table class="v3-versus-table">
        <thead>
          <tr>
            <% t("v3.versus.headers").each do |h| %>
              <th><%= h %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% t("v3.versus.rows").each do |row| %>
            <tr>
              <td><%= row[:label] %></td>
              <td><%= row[:x] %></td>
              <% row[:others].each do |o| %>
                <td style="color: var(--c-muted);"><%= o %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# ═══════════════════════════════════════════════════════════════ %>
<%# SECTION 6 — CTA                                                 %>
<%# ═══════════════════════════════════════════════════════════════ %>
<section class="v3-cta">
  <div class="v3-wrap v3-cta__inner">
    <h2 class="v3-cta__title"><%= t("v3.cta.title") %></h2>
    <div class="v3-cta__btns">
      <%= link_to t("v3.hero.cta_demo"),    demo_path(locale: I18n.locale),    class: "v3-btn-primary" %>
      <%= link_to t("v3.hero.cta_contact"), contact_path(locale: I18n.locale), class: "v3-btn-ghost" %>
    </div>
  </div>
</section>

</div><%# .v3-root %>
