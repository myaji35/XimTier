<% content_for :title, "AI 통계분석 솔루션 — XimTier" %>

<div class="v3-root">
<style>
.v3-root {
  --c-rausch:#ff385c; --c-canvas:#ffffff; --c-ink:#222222; --c-body:#3f3f3f;
  --c-muted:#6a6a6a; --c-hairline:#dddddd; --c-navy:#0a1124; --c-navy2:#16325c;
  --c-teal:#00c8c8; --c-blue:#2563eb;
  --grad-teal:linear-gradient(135deg,#2563eb,#00c8c8);
  --font-sans:'Airbnb Cereal VF',Circular,Inter,system-ui,'Apple SD Gothic Neo',sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,monospace;
  font-family:var(--font-sans); color:var(--c-body);
}
.v3-wrap { max-width:1160px; margin:0 auto; padding:0 24px; }
.v3-eyebrow { font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:var(--c-teal); margin-bottom:16px; }
.v3-hero { background:var(--c-navy); padding:100px 0 72px; position:relative; overflow:hidden; }
.v3-hero::before { content:''; position:absolute; inset:0; background:radial-gradient(800px 500px at 75% 20%,rgba(0,200,200,0.12),transparent 60%),radial-gradient(600px 400px at 10% 85%,rgba(37,99,235,0.16),transparent 60%); pointer-events:none; }
.v3-hero__inner { position:relative; }
.v3-hero__headline { font-size:clamp(28px,4vw,50px); font-weight:700; line-height:1.22; color:#fff; word-break:keep-all; margin:0 0 20px; max-width:700px; }
.v3-hero__sub { font-size:17px; line-height:1.7; color:#a7b1c7; max-width:560px; margin:0 0 36px; word-break:keep-all; }
.v3-section { padding:88px 0; }
.v3-section--dark { background:var(--c-navy); color:#fff; }
.v3-section--alt { background:#f7f8fa; }
.v3-section__eyebrow { font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:var(--c-teal); margin-bottom:14px; }
.v3-section__title { font-size:clamp(22px,3vw,36px); font-weight:700; color:var(--c-ink); line-height:1.25; margin:0 0 14px; word-break:keep-all; }
.v3-section--dark .v3-section__title { color:#fff; }
.v3-section__lead { font-size:16px; line-height:1.75; color:var(--c-muted); max-width:620px; word-break:keep-all; }
.v3-section--dark .v3-section__lead { color:#a7b1c7; }
/* pipeline steps */
.v3-pipeline { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-top:44px; position:relative; }
@media(max-width:900px){ .v3-pipeline { grid-template-columns:1fr 1fr; } }
@media(max-width:480px){ .v3-pipeline { grid-template-columns:1fr; } }
.v3-pipe-step { background:rgba(255,255,255,0.045); border:1px solid rgba(255,255,255,0.09); border-radius:14px; padding:22px 18px; position:relative; }
.v3-pipe-step--active { border-color:rgba(0,200,200,0.4); background:rgba(0,200,200,0.07); }
.v3-pipe-num { font-family:var(--font-mono); font-size:10px; font-weight:700; color:var(--c-teal); letter-spacing:0.14em; margin-bottom:10px; }
.v3-pipe-title { font-size:13px; font-weight:700; color:#fff; margin-bottom:6px; word-break:keep-all; line-height:1.4; }
.v3-pipe-desc { font-size:11.5px; color:#7a8aab; line-height:1.5; word-break:keep-all; }
/* algo grid */
.v3-algo-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:44px; }
@media(max-width:860px){ .v3-algo-grid { grid-template-columns:repeat(2,1fr); } }
@media(max-width:480px){ .v3-algo-grid { grid-template-columns:1fr; } }
.v3-algo-card { background:rgba(37,99,235,0.1); border:1px solid rgba(37,99,235,0.25); border-radius:14px; padding:24px 20px; text-align:center; }
.v3-algo-count { font-family:var(--font-mono); font-size:32px; font-weight:700; color:var(--c-teal); margin-bottom:8px; }
.v3-algo-name { font-size:14px; font-weight:700; color:#fff; margin-bottom:6px; word-break:keep-all; }
.v3-algo-desc { font-size:12px; color:#7a8aab; word-break:keep-all; line-height:1.5; }
/* reporting */
.v3-report-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:44px; }
@media(max-width:700px){ .v3-report-grid { grid-template-columns:1fr; } }
.v3-report-card { background:rgba(255,255,255,0.045); border:1px solid rgba(255,255,255,0.09); border-radius:14px; padding:24px 20px; }
.v3-report-card__icon { font-size:10px; font-family:var(--font-mono); color:var(--c-teal); letter-spacing:0.14em; text-transform:uppercase; margin-bottom:10px; }
.v3-report-card__title { font-size:14px; font-weight:700; color:#fff; margin-bottom:8px; word-break:keep-all; }
.v3-report-card__desc { font-size:12.5px; color:#7a8aab; line-height:1.6; word-break:keep-all; }
/* slide */
.v3-slide-img { border-radius:16px; overflow:hidden; box-shadow:0 20px 60px -10px rgba(0,0,0,0.35); margin-top:40px; }
.v3-slide-img img { width:100%; height:auto; display:block; }
.v3-slides-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:40px; }
@media(max-width:700px){ .v3-slides-row { grid-template-columns:1fr; } }
/* bar */
.v3-bar { padding:40px 0; border-top:1px solid var(--c-hairline); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; }
.v3-btn-primary { display:inline-block; padding:14px 28px; background:var(--c-rausch); color:#fff; font-size:14px; font-weight:700; border-radius:10px; text-decoration:none; transition:opacity 0.15s,transform 0.15s; box-shadow:0 8px 24px -4px rgba(255,56,92,0.4); }
.v3-btn-primary:hover { opacity:0.88; transform:translateY(-1px); }
.v3-back { font-size:14px; color:var(--c-muted); text-decoration:none; }
.v3-back:hover { color:var(--c-ink); }
</style>

<!-- Hero -->
<section class="v3-hero">
  <div class="v3-wrap">
    <div class="v3-hero__inner">
      <div class="v3-eyebrow">Chapter 03</div>
      <h1 class="v3-hero__headline">AI 통계분석 솔루션</h1>
      <p class="v3-hero__sub">변수 선정부터 예측·시뮬레이션까지 5단계 AI 분석 파이프라인. 회귀·판별·다중분류·시계열 127개 알고리즘이 동시 경쟁하여 최적 모델을 선정합니다.</p>
    </div>
  </div>
</section>

<!-- AI 분석 파이프라인 5단계 -->
<section class="v3-section v3-section--dark">
  <div class="v3-wrap">
    <div class="v3-section__eyebrow">AI Analysis Pipeline</div>
    <h2 class="v3-section__title">AI 분석 파이프라인 5단계</h2>
    <p class="v3-section__lead">각 단계는 이전 단계의 결과를 자동으로 이어받아 분석 품질을 높입니다.</p>
    <div class="v3-pipeline">
      <div class="v3-pipe-step v3-pipe-step--active">
        <div class="v3-pipe-num">STEP 01</div>
        <div class="v3-pipe-title">변수 선정 및 파생 데이터</div>
        <div class="v3-pipe-desc">AI가 목표 변수와 입력 변수를 자동 선정하고 파생 변수를 생성합니다.</div>
      </div>
      <div class="v3-pipe-step">
        <div class="v3-pipe-num">STEP 02</div>
        <div class="v3-pipe-title">변수 이해 및 XAI</div>
        <div class="v3-pipe-desc">SHAP·LIME 기반 XAI로 각 변수의 기여도와 영향 방향을 설명합니다.</div>
      </div>
      <div class="v3-pipe-step">
        <div class="v3-pipe-num">STEP 03</div>
        <div class="v3-pipe-title">알고리즘 경쟁 및 검증</div>
        <div class="v3-pipe-desc">127개 알고리즘이 동시 경쟁하여 최적 모델을 자동 선정하고 교차 검증합니다.</div>
      </div>
      <div class="v3-pipe-step">
        <div class="v3-pipe-num">STEP 04</div>
        <div class="v3-pipe-title">예측·시뮬레이션 XY 최적화</div>
        <div class="v3-pipe-desc">What-If·Reverse What-If 시뮬레이션으로 목표 달성 최적 조건을 역산합니다.</div>
      </div>
      <div class="v3-pipe-step">
        <div class="v3-pipe-num">STEP 05</div>
        <div class="v3-pipe-title">AI Q&A GraphRAG</div>
        <div class="v3-pipe-desc">분석 결과에 대해 자연어로 질문하면 GraphRAG 기반 AI가 정밀하게 답변합니다.</div>
      </div>
    </div>
    <div class="v3-slide-img">
      <img src="/deck-slides/slide-34.jpg" alt="AI 분석 파이프라인">
    </div>
  </div>
</section>

<!-- 4종 분석 알고리즘 -->
<section class="v3-section v3-section--dark" style="padding-top:0;">
  <div class="v3-wrap">
    <div class="v3-section__eyebrow">Algorithm Competition</div>
    <h2 class="v3-section__title">4종 분석, 127개 알고리즘</h2>
    <p class="v3-section__lead">분석 목적에 따라 최적 알고리즘 유형을 자동 선택하고 내부 경쟁으로 최고 성능 모델을 확보합니다.</p>
    <div class="v3-algo-grid">
      <div class="v3-algo-card">
        <div class="v3-algo-count">32</div>
        <div class="v3-algo-name">회귀 분석</div>
        <div class="v3-algo-desc">연속형 수치 예측 — 매출·수요·가격 등 정량 목표 최적화</div>
      </div>
      <div class="v3-algo-card">
        <div class="v3-algo-count">17</div>
        <div class="v3-algo-name">판별 분석</div>
        <div class="v3-algo-desc">이진 분류 — 불량/정상, 이탈/유지, 성공/실패 판별</div>
      </div>
      <div class="v3-algo-card">
        <div class="v3-algo-count">17</div>
        <div class="v3-algo-name">다중분류 분석</div>
        <div class="v3-algo-desc">3개 이상 범주 분류 — 고객 등급, 제품 유형, 시장 세분화</div>
      </div>
      <div class="v3-algo-card">
        <div class="v3-algo-count">61</div>
        <div class="v3-algo-name">시계열 분석</div>
        <div class="v3-algo-desc">시간 패턴 예측 — 수요 예측, 이상 감지, 계절성 분해</div>
      </div>
    </div>
  </div>
</section>

<!-- Xim4Reporting -->
<section class="v3-section v3-section--dark" style="padding-top:0;">
  <div class="v3-wrap">
    <div class="v3-section__eyebrow">Xim4Reporting</div>
    <h2 class="v3-section__title">Xim4Reporting — 수시 자동 보고</h2>
    <p class="v3-section__lead">모델 배포 후에도 성능을 지속 모니터링하고 What-If 결과를 자동으로 보고서화합니다.</p>
    <div class="v3-report-grid">
      <div class="v3-report-card">
        <div class="v3-report-card__icon">Report 01</div>
        <div class="v3-report-card__title">수시 성능 평가</div>
        <div class="v3-report-card__desc">배포된 모델의 정확도·정밀도·재현율을 주기적으로 자동 평가하고 성능 저하를 조기에 감지합니다.</div>
      </div>
      <div class="v3-report-card">
        <div class="v3-report-card__icon">Report 02</div>
        <div class="v3-report-card__title">수시 What-If 보고</div>
        <div class="v3-report-card__desc">입력 조건 변경에 따른 예측 결과 변화를 자동으로 시뮬레이션하고 의사결정 시나리오를 보고서화합니다.</div>
      </div>
      <div class="v3-report-card">
        <div class="v3-report-card__icon">Report 03</div>
        <div class="v3-report-card__title">수시 Reverse What-If 보고</div>
        <div class="v3-report-card__desc">목표값을 먼저 설정하면 AI가 달성 조건을 역으로 계산하여 실행 가능한 전략을 자동 제시합니다.</div>
      </div>
    </div>
    <div class="v3-slides-row">
      <div class="v3-slide-img" style="margin-top:0;">
        <img src="/deck-slides/slide-52.jpg" alt="Xim4Reporting 성능 평가">
      </div>
      <div class="v3-slide-img" style="margin-top:0;">
        <img src="/deck-slides/slide-56.jpg" alt="Reverse What-If 보고">
      </div>
    </div>
  </div>
</section>

<!-- Bottom CTA -->
<section class="v3-section" style="padding:60px 0;">
  <div class="v3-wrap">
    <div class="v3-bar">
      <%= link_to "← 홈으로", home_path(locale: I18n.locale), class: "v3-back" %>
      <%= link_to "데모 신청", demo_path(locale: I18n.locale), class: "v3-btn-primary" %>
    </div>
  </div>
</section>

</div>
