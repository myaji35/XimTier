<% content_for :title, t("v3pages.solutions.hero.title") %>
<% content_for :description, t("v3pages.solutions.hero.description") %>

<div class="v3-root">
<style>
.v3-root {
  --c-rausch:#ff385c; --c-canvas:#ffffff; --c-ink:#222222; --c-body:#3f3f3f;
  --c-muted:#6a6a6a; --c-hairline:#dddddd; --c-navy:#0a1124; --c-navy2:#16325c;
  --c-teal:#00c8c8; --c-blue:#2563eb;
  --grad-teal:linear-gradient(135deg,#2563eb,#00c8c8);
  --font-sans:'Airbnb Cereal VF',Circular,Inter,system-ui,'Apple SD Gothic Neo',sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,monospace;
  font-family:var(--font-sans); color:var(--c-body);
}
.v3-wrap { max-width:1160px; margin:0 auto; padding:0 24px; }
.v3-eyebrow { font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:var(--c-teal); margin-bottom:16px; }

/* Hero */
.v3-hero { background:var(--c-navy); padding:100px 0 72px; position:relative; overflow:hidden; }
.v3-hero::before { content:''; position:absolute; inset:0; background:radial-gradient(800px 500px at 75% 20%,rgba(0,200,200,0.12),transparent 60%),radial-gradient(600px 400px at 10% 85%,rgba(37,99,235,0.16),transparent 60%); pointer-events:none; }
.v3-hero__inner { position:relative; }
.v3-hero__back { display:inline-block; font-size:13px; color:#7a8aab; text-decoration:none; margin-bottom:24px; }
.v3-hero__back:hover { color:#fff; }
.v3-hero__headline { font-size:clamp(28px,4vw,50px); font-weight:700; line-height:1.22; color:#fff; word-break:keep-all; margin:0 0 20px; max-width:700px; }
.v3-hero__sub { font-size:17px; line-height:1.7; color:#a7b1c7; max-width:600px; margin:0; word-break:keep-all; }

/* Sections */
.v3-section { padding:88px 0; }
.v3-section__eyebrow { font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:var(--c-teal); margin-bottom:14px; }
.v3-section__title { font-size:clamp(22px,3vw,36px); font-weight:700; color:var(--c-ink); line-height:1.25; margin:0 0 14px; word-break:keep-all; }
.v3-section__lead { font-size:16px; line-height:1.75; color:var(--c-muted); max-width:620px; word-break:keep-all; }

/* 2-col solution grid */
.v3-sol-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:44px; }
@media(max-width:640px){ .v3-sol-grid { grid-template-columns:1fr; } }
.v3-sol-card { display:block; text-decoration:none; background:var(--c-canvas); border:1px solid var(--c-hairline); border-radius:14px; padding:24px 22px; transition:box-shadow 0.15s,transform 0.15s,border-color 0.15s; }
.v3-sol-card:hover { box-shadow:0 8px 24px rgba(0,0,0,0.08); transform:translateY(-2px); border-color:rgba(0,200,200,0.45); }
.v3-sol-card__idx { font-family:var(--font-mono); font-size:10px; font-weight:700; letter-spacing:0.12em; color:var(--c-teal); margin-bottom:10px; }
.v3-sol-card__name { font-size:15px; font-weight:700; color:var(--c-ink); word-break:keep-all; }
.v3-sol-card__more { font-family:var(--font-mono); font-size:10px; font-weight:700; letter-spacing:0.08em; color:var(--c-teal); margin-top:12px; opacity:0; transition:opacity 0.15s; }
.v3-sol-card:hover .v3-sol-card__more { opacity:1; }

/* CTA */
.v3-cta-section { background:var(--c-navy); padding:72px 0; }
.v3-cta-section__inner { text-align:center; }
.v3-cta-section__title { font-size:clamp(22px,3vw,34px); font-weight:700; color:#fff; margin:0 0 12px; word-break:keep-all; }
.v3-cta-section__lead { font-size:15px; color:#a7b1c7; margin:0 0 32px; word-break:keep-all; }
.v3-cta-btns { display:flex; flex-wrap:wrap; gap:14px; justify-content:center; }
.v3-btn-primary { display:inline-block; padding:14px 28px; background:var(--c-rausch); color:#fff; font-size:14px; font-weight:700; border-radius:10px; text-decoration:none; transition:opacity 0.15s,transform 0.15s; box-shadow:0 8px 24px -4px rgba(255,56,92,0.4); }
.v3-btn-primary:hover { opacity:0.88; transform:translateY(-1px); }
.v3-btn-ghost { display:inline-block; padding:13px 24px; background:transparent; color:#a7b1c7; font-size:14px; font-weight:600; border-radius:10px; text-decoration:none; border:1px solid rgba(255,255,255,0.18); transition:border-color 0.15s,color 0.15s; }
.v3-btn-ghost:hover { border-color:rgba(255,255,255,0.45); color:#fff; }
</style>

<!-- Hero -->
<section class="v3-hero">
  <div class="v3-wrap">
    <div class="v3-hero__inner">
      <a href="<%= root_path(locale: I18n.locale) %>" class="v3-hero__back"><%= t("v3pages.solutions.hero.back") %></a>
      <div class="v3-eyebrow">Chapter 04</div>
      <h1 class="v3-hero__headline"><%= t("v3pages.solutions.hero.title") %></h1>
      <p class="v3-hero__sub"><%= t("v3pages.solutions.hero.description") %></p>
    </div>
  </div>
</section>

<!-- 10 솔루션 카드 -->
<section class="v3-section">
  <div class="v3-wrap">
    <div class="v3-section__eyebrow">Domain Solutions</div>
    <h2 class="v3-section__title"><%= t("v3pages.solutions.domains.title") %></h2>
    <p class="v3-section__lead"><%= t("v3pages.solutions.domains.lead") %></p>
    <div class="v3-sol-grid">
      <% [
        ["SOL 01", t("v3pages.solutions.domains.meeting.title"), "sol_meeting"],
        ["SOL 02", t("v3pages.solutions.domains.survey.title"), "sol_survey"],
        ["SOL 03", t("v3pages.solutions.domains.sns.title"), "sol_sns"],
        ["SOL 04", t("v3pages.solutions.domains.festival.title"), "sol_festival"],
        ["SOL 05", t("v3pages.solutions.domains.market.title"), "sol_market"],
        ["SOL 06", t("v3pages.solutions.domains.store.title"), "sol_store"],
        ["SOL 07", t("v3pages.solutions.domains.clinic.title"), "sol_clinic"],
        ["SOL 08", t("v3pages.solutions.domains.maintenance.title"), "sol_maintenance"],
        ["SOL 09", t("v3pages.solutions.domains.sns_product.title"), "sol_sns_product"],
        ["SOL 10", t("v3pages.solutions.domains.survey_product.title"), "sol_survey_product"],
      ].each do |idx, name, slug| %>
        <%= link_to v3_detail_path(slug: slug, locale: I18n.locale), class: "v3-sol-card" do %>
          <div class="v3-sol-card__idx"><%= idx %></div>
          <div class="v3-sol-card__name"><%= name %></div>
          <div class="v3-sol-card__more"><%= t("v3pages.solutions.domains.more") %></div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="v3-cta-section">
  <div class="v3-wrap">
    <div class="v3-cta-section__inner">
      <h2 class="v3-cta-section__title"><%= t("v3pages.solutions.cta.title") %></h2>
      <p class="v3-cta-section__lead"><%= t("v3pages.solutions.cta.lead") %></p>
      <div class="v3-cta-btns">
        <%= link_to t("v3pages.solutions.cta.demo"), demo_path(locale: I18n.locale), class: "v3-btn-primary" %>
        <%= link_to t("v3pages.solutions.cta.contact"), contact_path(locale: I18n.locale), class: "v3-btn-ghost" %>
      </div>
    </div>
  </div>
</section>

</div>
