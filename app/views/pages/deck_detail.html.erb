<% content_for :title, @detail[:title] %>
<style>
  .dd-root { --navy:#0a1124; --teal:#00C8C8; --blue:#2563EB; }
  .dd-root * { box-sizing:border-box; }
  .dd-nav { position:sticky; top:0; z-index:50; background:rgba(10,17,36,0.92); backdrop-filter:blur(8px); border-bottom:1px solid rgba(255,255,255,0.08); }
  .dd-nav-inner { max-width:1140px; margin:0 auto; display:flex; align-items:center; gap:16px; padding:14px 20px; }
  .dd-back { color:#a7b1c7; text-decoration:none; font-size:13px; font-weight:600; }
  .dd-back:hover { color:#00C8C8; }
  .dd-brand { color:#fff; font-weight:800; font-size:18px; text-decoration:none; margin-left:auto; }
  .dd-hero { background:var(--navy); color:#fff; padding:64px 0 48px; }
  .dd-wrap { max-width:1140px; margin:0 auto; padding:0 20px; }
  .dd-chapter { font-family:ui-monospace,monospace; font-size:12px; letter-spacing:1px; color:var(--teal); }
  .dd-title { font-size:38px; font-weight:800; margin:10px 0 0; color:#fff; word-break:keep-all; }
  .dd-lead { font-size:16px; line-height:1.6; color:#a7b1c7; margin-top:16px; max-width:820px; }
  .dd-body { background:#fff; color:#222; padding:56px 0; }
  .dd-section { margin-bottom:40px; }
  .dd-section h3 { font-size:18px; font-weight:700; color:var(--navy); margin:0 0 8px; }
  .dd-section p { font-size:14px; line-height:1.7; color:#3f3f3f; margin:0; max-width:820px; }
  .dd-slide { width:100%; border:1px solid #e6e6e6; border-radius:12px; margin:18px 0; box-shadow:0 8px 30px -12px rgba(0,0,0,0.18); }
  .dd-cta { background:var(--navy); color:#fff; padding:48px 0; text-align:center; }
  .dd-btn { display:inline-block; background:linear-gradient(135deg,var(--blue),var(--teal)); color:#fff; padding:13px 28px; border-radius:10px; text-decoration:none; font-weight:700; margin-top:8px; }
  @media (max-width:820px){ .dd-title{font-size:28px;} }
</style>

<div class="dd-root">
  <nav class="dd-nav">
    <div class="dd-nav-inner">
      <a href="<%= deck_path(locale: I18n.locale) %>" class="dd-back">← 메뉴 구성으로 돌아가기</a>
      <a href="<%= deck_path(locale: I18n.locale) %>" class="dd-brand">XimTier</a>
    </div>
  </nav>

  <section class="dd-hero">
    <div class="dd-wrap">
      <div class="dd-chapter"><%= @detail[:chapter] %></div>
      <h1 class="dd-title"><%= @detail[:title] %></h1>
      <p class="dd-lead"><%= @detail[:lead] %></p>
    </div>
  </section>

  <section class="dd-body">
    <div class="dd-wrap">
      <% @detail[:sections].each do |sec| %>
        <div class="dd-section">
          <h3><%= sec[:h] %></h3>
          <p><%= sec[:body] %></p>
        </div>
      <% end %>

      <% @detail[:slides].each do |n| %>
        <img class="dd-slide" src="<%= "/deck-slides/slide-%02d.jpg" % n %>" alt="<%= @detail[:title] %> 화면 <%= n %>" loading="lazy">
      <% end %>
    </div>
  </section>

  <section class="dd-cta">
    <div class="dd-wrap">
      <a href="<%= demo_path(locale: I18n.locale) %>" class="dd-btn">데모 신청</a>
    </div>
  </section>
</div>
