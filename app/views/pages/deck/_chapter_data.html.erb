<section id="data" class="deck-light deck-section">
  <div class="deck-wrap">
    <span class="deck-chapter-no" style="background:var(--blue);color:#fff;"><%= t("deck.chapters.data.num") %></span>
    <h2 class="deck-h2" style="color:#222;margin-top:12px;"><%= t("deck.chapters.data.title") %></h2>
    <div class="deck-grid deck-grid-4">
      <% items = t("deck.chapters.data.items"); descs = t("deck.chapters.data.descs") %>
      <% slugs = %w[data-exploration whatdata-ai address-xy explore-chart text-explore thematic-map insight-report target-yx] %>
      <% items.each_with_index do |item, i| %>
        <a class="deck-card deck-card-link" href="<%= deck_detail_path(slug: slugs[i], locale: I18n.locale) %>">
          <div class="deck-card-num"><%= "%02d" % (i+1) %></div>
          <div class="deck-card-title"><%= item %></div>
          <div class="deck-card-desc"><%= descs[i] %></div>
          <div class="deck-card-more">자세히 →</div>
        </a>
      <% end %>
    </div>
  </div>
</section>
