<% content_for :title, "메뉴 구성 개요" %>

<div class="v3-root">
<style>
.v3-root {
  --c-rausch:#ff385c; --c-canvas:#ffffff; --c-ink:#222222; --c-body:#3f3f3f;
  --c-muted:#6a6a6a; --c-hairline:#dddddd; --c-navy:#0a1124; --c-navy2:#16325c;
  --c-teal:#00c8c8; --c-blue:#2563eb;
  --grad-teal:linear-gradient(135deg,#2563eb,#00c8c8);
  --font-sans:'Airbnb Cereal VF',Circular,Inter,system-ui,'Apple SD Gothic Neo',sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,monospace;
  font-family:var(--font-sans); color:var(--c-body);
}
.v3-wrap { max-width:1160px; margin:0 auto; padding:0 24px; }
.v3-eyebrow { font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:var(--c-teal); margin-bottom:16px; }
.v3-grad-text { background:var(--grad-teal); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

/* Hero */
.v3-hero { background:var(--c-navy); padding:100px 0 72px; position:relative; overflow:hidden; }
.v3-hero::before { content:''; position:absolute; inset:0; background:radial-gradient(800px 500px at 75% 20%,rgba(0,200,200,0.12),transparent 60%),radial-gradient(600px 400px at 10% 85%,rgba(37,99,235,0.16),transparent 60%); pointer-events:none; }
.v3-hero__inner { position:relative; }
.v3-hero__back { display:inline-block; font-size:13px; color:#7a8aab; text-decoration:none; margin-bottom:24px; }
.v3-hero__back:hover { color:#fff; }
.v3-hero__headline { font-size:clamp(28px,4vw,50px); font-weight:700; line-height:1.22; color:#fff; word-break:keep-all; margin:0 0 20px; max-width:700px; }
.v3-hero__sub { font-size:17px; line-height:1.7; color:#a7b1c7; max-width:560px; margin:0; word-break:keep-all; }

/* Sections */
.v3-section { padding:88px 0; }
.v3-section--alt { background:#f7f8fa; }
.v3-section--dark { background:var(--c-navy); color:#fff; }
.v3-section__eyebrow { font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:var(--c-teal); margin-bottom:14px; }
.v3-section__title { font-size:clamp(22px,3vw,36px); font-weight:700; color:var(--c-ink); line-height:1.25; margin:0 0 14px; word-break:keep-all; }
.v3-section--dark .v3-section__title { color:#fff; }
.v3-section__lead { font-size:16px; line-height:1.75; color:var(--c-muted); max-width:620px; word-break:keep-all; }
.v3-section--dark .v3-section__lead { color:#a7b1c7; }

/* 3-layer arch */
.v3-arch-stack { display:flex; flex-direction:column; gap:4px; margin-top:44px; max-width:780px; margin-left:auto; margin-right:auto; }
.v3-arch-layer { display:block; text-decoration:none; border-radius:14px; padding:28px 32px; transition:transform 0.15s,box-shadow 0.15s; position:relative; }
.v3-arch-layer:hover { transform:translateY(-2px); box-shadow:0 10px 30px rgba(0,0,0,0.28); }
.v3-arch-more { font-family:var(--font-mono); font-size:10px; font-weight:700; letter-spacing:0.08em; color:var(--c-teal); margin-top:12px; opacity:0; transition:opacity 0.15s; }
.v3-arch-layer:hover .v3-arch-more { opacity:1; }
.v3-arch-layer--top  { background:linear-gradient(135deg,rgba(37,99,235,0.18),rgba(0,200,200,0.12)); border:1px solid rgba(0,200,200,0.28); }
.v3-arch-layer--core { background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); }
.v3-arch-layer--base { background:rgba(37,99,235,0.12); border:1px solid rgba(37,99,235,0.28); }
.v3-arch-label { font-family:var(--font-mono); font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--c-teal); margin-bottom:6px; }
.v3-arch-name { font-size:16px; font-weight:700; color:#fff; margin-bottom:4px; }
.v3-arch-desc { font-size:13px; color:#7a8aab; word-break:keep-all; }

/* Roadmap */
.v3-roadmap { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-top:44px; }
@media(max-width:900px){ .v3-roadmap { grid-template-columns:repeat(3,1fr); } }
@media(max-width:560px){ .v3-roadmap { grid-template-columns:1fr 1fr; } }
.v3-roadmap-item { background:rgba(255,255,255,0.045); border:1px solid rgba(255,255,255,0.09); border-radius:12px; padding:18px 16px; }
.v3-roadmap-item--active { border-color:rgba(0,200,200,0.4); background:rgba(0,200,200,0.08); }
.v3-roadmap-year { font-family:var(--font-mono); font-size:11px; font-weight:700; color:var(--c-teal); margin-bottom:8px; }
.v3-roadmap-label { font-size:12px; font-weight:700; color:#fff; margin-bottom:4px; word-break:keep-all; }
.v3-roadmap-desc { font-size:11px; color:#7a8aab; line-height:1.5; word-break:keep-all; }

/* CTA bar */
.v3-cta-section { background:var(--c-navy); padding:72px 0; }
.v3-cta-section__inner { text-align:center; }
.v3-cta-section__title { font-size:clamp(22px,3vw,34px); font-weight:700; color:#fff; margin:0 0 12px; word-break:keep-all; }
.v3-cta-section__lead { font-size:15px; color:#a7b1c7; margin:0 0 32px; word-break:keep-all; }
.v3-cta-btns { display:flex; flex-wrap:wrap; gap:14px; justify-content:center; }
.v3-btn-primary { display:inline-block; padding:14px 28px; background:var(--c-rausch); color:#fff; font-size:14px; font-weight:700; border-radius:10px; text-decoration:none; transition:opacity 0.15s,transform 0.15s; box-shadow:0 8px 24px -4px rgba(255,56,92,0.4); }
.v3-btn-primary:hover { opacity:0.88; transform:translateY(-1px); }
.v3-btn-ghost { display:inline-block; padding:13px 24px; background:transparent; color:#a7b1c7; font-size:14px; font-weight:600; border-radius:10px; text-decoration:none; border:1px solid rgba(255,255,255,0.18); transition:border-color 0.15s,color 0.15s; }
.v3-btn-ghost:hover { border-color:rgba(255,255,255,0.45); color:#fff; }
</style>

<!-- Hero -->
<section class="v3-hero">
  <div class="v3-wrap">
    <div class="v3-hero__inner">
      <a href="<%= root_path(locale: I18n.locale) %>" class="v3-hero__back">← XimTier 홈</a>
      <div class="v3-eyebrow">Chapter 01</div>
      <h1 class="v3-hero__headline">메뉴 구성 개요</h1>
      <p class="v3-hero__sub">데이터 탐색부터 AI 분석, 최적화 시뮬레이션, 자동 보고서, AI Q&A까지 한 번에 수행하는 One-Stop AI 의사결정 플랫폼.</p>
    </div>
  </div>
</section>

<!-- Section A: 3단 지능형 아키텍처 -->
<section class="v3-section v3-section--dark">
  <div class="v3-wrap">
    <div class="v3-section__eyebrow">Platform Architecture</div>
    <h2 class="v3-section__title">3단 지능형 아키텍처</h2>
    <p class="v3-section__lead">산업 특화 솔루션부터 통계 엔진까지, 세 개 레이어가 유기적으로 연결됩니다.</p>
    <div class="v3-arch-stack">
      <%= link_to v3_detail_path(slug: "arch_top", locale: I18n.locale), class: "v3-arch-layer v3-arch-layer--top" do %>
        <div class="v3-arch-label">Top Layer</div>
        <div class="v3-arch-name">XimSolution</div>
        <div class="v3-arch-desc">산업 특화 솔루션 — 도메인별 사전 구성된 AI 의사결정 패키지</div>
        <div class="v3-arch-more">상세 보기 →</div>
      <% end %>
      <%= link_to v3_detail_path(slug: "arch_core", locale: I18n.locale), class: "v3-arch-layer v3-arch-layer--core" do %>
        <div class="v3-arch-label">Core Layer</div>
        <div class="v3-arch-name">WhatDataAI</div>
        <div class="v3-arch-desc">60종 알고리즘 · XAI 변수 이해 · What-If / Reverse What-If 최적화</div>
        <div class="v3-arch-more">상세 보기 →</div>
      <% end %>
      <%= link_to v3_detail_path(slug: "arch_base", locale: I18n.locale), class: "v3-arch-layer v3-arch-layer--base" do %>
        <div class="v3-arch-label">Base Layer</div>
        <div class="v3-arch-name">통계·분석 엔진</div>
        <div class="v3-arch-desc">데이터 인프라 — 수집·정제·좌표 파싱·기초 통계·시각화 기반</div>
        <div class="v3-arch-more">상세 보기 →</div>
      <% end %>
    </div>
  </div>
</section>

<!-- Section B: 최적화 로드맵 -->
<section class="v3-section v3-section--dark" style="padding-top:0;">
  <div class="v3-wrap">
    <div class="v3-section__eyebrow">Roadmap</div>
    <h2 class="v3-section__title">최적화 로드맵</h2>
    <div class="v3-roadmap">
      <div class="v3-roadmap-item">
        <div class="v3-roadmap-year">01 · 2024</div>
        <div class="v3-roadmap-label">기반 구축 단계</div>
        <div class="v3-roadmap-desc">핵심 엔진 및 데이터 기반 구축 — WhatDataAI 엔진 고도화·Reverse What-if 엔진 개발</div>
      </div>
      <div class="v3-roadmap-item v3-roadmap-item--active">
        <div class="v3-roadmap-year">02 · 2025</div>
        <div class="v3-roadmap-label">플랫폼 확장 단계</div>
        <div class="v3-roadmap-desc">산업별 솔루션 및 의사결정 최적화 — 산업별 최적화 솔루션·회의·의사결정 최적화</div>
      </div>
      <div class="v3-roadmap-item">
        <div class="v3-roadmap-year">03 · 2026</div>
        <div class="v3-roadmap-label">지능 고도화 단계</div>
        <div class="v3-roadmap-desc">AI 최적화 고도화 및 자동 실행 지원 — AI 최적화 엔진·AI Agent & 자동 실행 연계</div>
      </div>
      <div class="v3-roadmap-item">
        <div class="v3-roadmap-year">04 · 2027–2028</div>
        <div class="v3-roadmap-label">생태계 확장 단계</div>
        <div class="v3-roadmap-desc">파트너 생태계 및 글로벌 확장 — 파트너 생태계 구축·글로벌 확장</div>
      </div>
      <div class="v3-roadmap-item">
        <div class="v3-roadmap-year">05 · 2028–2030+</div>
        <div class="v3-roadmap-label">바이오 혁신 단계</div>
        <div class="v3-roadmap-desc">바이오·정밀의료·신약 최적화 확장 — 유전자·단백질·경로 분석·Reverse Bio-Design 엔진</div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="v3-cta-section">
  <div class="v3-wrap">
    <div class="v3-cta-section__inner">
      <h2 class="v3-cta-section__title">직접 경험해보세요</h2>
      <p class="v3-cta-section__lead">데모 신청 후 플랫폼 전체를 체험하실 수 있습니다.</p>
      <div class="v3-cta-btns">
        <%= link_to "데모 신청", demo_path(locale: I18n.locale), class: "v3-btn-primary" %>
        <%= link_to "문의하기", contact_path(locale: I18n.locale), class: "v3-btn-ghost" %>
      </div>
    </div>
  </div>
</section>

</div>
