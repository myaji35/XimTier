<% content_for :title, "업무 활용 방안 — XimTier" %>

<div class="v3-root">
<style>
.v3-root {
  --c-rausch:#ff385c; --c-canvas:#ffffff; --c-ink:#222222; --c-body:#3f3f3f;
  --c-muted:#6a6a6a; --c-hairline:#dddddd; --c-navy:#0a1124; --c-navy2:#16325c;
  --c-teal:#00c8c8; --c-blue:#2563eb;
  --grad-teal:linear-gradient(135deg,#2563eb,#00c8c8);
  --font-sans:'Airbnb Cereal VF',Circular,Inter,system-ui,'Apple SD Gothic Neo',sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,monospace;
  font-family:var(--font-sans); color:var(--c-body);
}
.v3-wrap { max-width:1160px; margin:0 auto; padding:0 24px; }
.v3-eyebrow { font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:var(--c-teal); margin-bottom:16px; }

/* Hero */
.v3-hero { background:var(--c-navy); padding:100px 0 72px; position:relative; overflow:hidden; }
.v3-hero::before { content:''; position:absolute; inset:0; background:radial-gradient(800px 500px at 75% 20%,rgba(0,200,200,0.12),transparent 60%),radial-gradient(600px 400px at 10% 85%,rgba(37,99,235,0.16),transparent 60%); pointer-events:none; }
.v3-hero__inner { position:relative; }
.v3-hero__back { display:inline-block; font-size:13px; color:#7a8aab; text-decoration:none; margin-bottom:24px; }
.v3-hero__back:hover { color:#fff; }
.v3-hero__headline { font-size:clamp(28px,4vw,50px); font-weight:700; line-height:1.22; color:#fff; word-break:keep-all; margin:0 0 20px; max-width:700px; }
.v3-hero__sub { font-size:17px; line-height:1.7; color:#a7b1c7; max-width:560px; margin:0; word-break:keep-all; }

/* Sections */
.v3-section { padding:88px 0; }
.v3-section__eyebrow { font-family:var(--font-mono); font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:var(--c-teal); margin-bottom:14px; }
.v3-section__title { font-size:clamp(22px,3vw,36px); font-weight:700; color:var(--c-ink); line-height:1.25; margin:0 0 14px; word-break:keep-all; }
.v3-section__lead { font-size:16px; line-height:1.75; color:var(--c-muted); max-width:620px; word-break:keep-all; }

/* 4-card usage grid */
.v3-usage-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:44px; }
@media(max-width:640px){ .v3-usage-grid { grid-template-columns:1fr; } }
.v3-usage-card { background:var(--c-canvas); border:1px solid var(--c-hairline); border-radius:16px; padding:32px 28px; transition:box-shadow 0.15s,transform 0.15s; }
.v3-usage-card:hover { box-shadow:0 10px 28px rgba(0,0,0,0.09); transform:translateY(-2px); }
.v3-usage-card__num { font-family:var(--font-mono); font-size:10px; font-weight:700; letter-spacing:0.12em; color:var(--c-teal); margin-bottom:12px; }
.v3-usage-card__title { font-size:16px; font-weight:700; color:var(--c-ink); margin-bottom:10px; word-break:keep-all; }
.v3-usage-card__desc { font-size:13.5px; color:var(--c-muted); line-height:1.7; word-break:keep-all; }

/* CTA */
.v3-cta-section { background:var(--c-navy); padding:72px 0; }
.v3-cta-section__inner { text-align:center; }
.v3-cta-section__title { font-size:clamp(22px,3vw,34px); font-weight:700; color:#fff; margin:0 0 12px; word-break:keep-all; }
.v3-cta-section__lead { font-size:15px; color:#a7b1c7; margin:0 0 32px; word-break:keep-all; }
.v3-cta-btns { display:flex; flex-wrap:wrap; gap:14px; justify-content:center; }
.v3-btn-primary { display:inline-block; padding:14px 28px; background:var(--c-rausch); color:#fff; font-size:14px; font-weight:700; border-radius:10px; text-decoration:none; transition:opacity 0.15s,transform 0.15s; box-shadow:0 8px 24px -4px rgba(255,56,92,0.4); }
.v3-btn-primary:hover { opacity:0.88; transform:translateY(-1px); }
.v3-btn-ghost { display:inline-block; padding:13px 24px; background:transparent; color:#a7b1c7; font-size:14px; font-weight:600; border-radius:10px; text-decoration:none; border:1px solid rgba(255,255,255,0.18); transition:border-color 0.15s,color 0.15s; }
.v3-btn-ghost:hover { border-color:rgba(255,255,255,0.45); color:#fff; }
</style>

<!-- Hero -->
<section class="v3-hero">
  <div class="v3-wrap">
    <div class="v3-hero__inner">
      <a href="<%= root_path(locale: I18n.locale) %>" class="v3-hero__back">← XimTier 홈</a>
      <div class="v3-eyebrow">Chapter 05</div>
      <h1 class="v3-hero__headline">업무 활용 방안</h1>
      <p class="v3-hero__sub">별도 시스템 구축 없이, 나만의 AI 의사결정 시스템을 갖습니다.</p>
    </div>
  </div>
</section>

<!-- 4 활용 카드 -->
<section class="v3-section">
  <div class="v3-wrap">
    <div class="v3-section__eyebrow">Business Application</div>
    <h2 class="v3-section__title">4가지 활용 방안</h2>
    <p class="v3-section__lead">기존 업무 흐름에 XimTier를 결합하면 AI 의사결정이 즉시 가능합니다.</p>
    <div class="v3-usage-grid">
      <div class="v3-usage-card">
        <div class="v3-usage-card__num">01</div>
        <div class="v3-usage-card__title">AX 활용성 강화 방안</div>
        <div class="v3-usage-card__desc">LLM의 과거 검색 능력과 XimTier의 미래 예측 능력을 결합. 현황 파악부터 최적 시나리오 도출까지 하나의 흐름으로.</div>
      </div>
      <div class="v3-usage-card">
        <div class="v3-usage-card__num">02</div>
        <div class="v3-usage-card__title">데이터 기반 AI 의사결정 플랫폼</div>
        <div class="v3-usage-card__desc">ROI 기반 자동화 — 분석 결과가 곧 실행 근거. 데이터가 쌓일수록 의사결정 정확도가 높아집니다.</div>
      </div>
      <div class="v3-usage-card">
        <div class="v3-usage-card__num">03</div>
        <div class="v3-usage-card__title">분야별 활용과 기대효과</div>
        <div class="v3-usage-card__desc">산업별 맞춤 설정·No Hallucination. 공공·의료·유통·제조 등 다양한 도메인에서 검증된 AI 분석.</div>
      </div>
      <div class="v3-usage-card">
        <div class="v3-usage-card__num">04</div>
        <div class="v3-usage-card__title">맞춤형 서비스 방안</div>
        <div class="v3-usage-card__desc">이기종 데이터 초융합·바이브코딩 기반 구축 70% 단축, 비용 50% 절감. 빠른 내재화가 가능합니다.</div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="v3-cta-section">
  <div class="v3-wrap">
    <div class="v3-cta-section__inner">
      <h2 class="v3-cta-section__title">우리 조직에 맞는 활용 방법을 찾아보세요</h2>
      <p class="v3-cta-section__lead">전문가와 함께 실제 업무 데이터로 가능성을 확인하세요.</p>
      <div class="v3-cta-btns">
        <%= link_to "데모 신청", demo_path(locale: I18n.locale), class: "v3-btn-primary" %>
        <%= link_to "문의하기", contact_path(locale: I18n.locale), class: "v3-btn-ghost" %>
      </div>
    </div>
  </div>
</section>

</div>
