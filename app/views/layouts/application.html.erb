<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <% og_image_url = "#{ENV.fetch('APP_PROTOCOL', 'http')}://#{ENV.fetch('APP_HOST', request.host_with_port)}/og-image.png" %>
    <% page_description = content_for(:description).presence || t("site.positioning") %>
    <%= display_meta_tags(
          site: t("site.brand"),
          title: content_for(:title).presence || t("site.positioning"),
          reverse: true,
          separator: "—",
          description: page_description,
          keywords: %w[XimTier Decision\ Intelligence Reverse\ What-If SHAP XAI Post-LLM EU\ AI\ Act],
          canonical: request.original_url,
          og: {
            type: "website",
            site_name: t("site.brand"),
            locale: I18n.locale.to_s,
            title: :title,
            description: :description,
            url: request.original_url,
            image: { _: content_for(:meta_og_image).presence ? content_for(:meta_og_image) : og_image_url, width: 1200, height: 630, alt: t("site.positioning") }
          },
          twitter: { card: "summary_large_image", image: content_for(:meta_og_image).presence ? content_for(:meta_og_image) : og_image_url }
        ) %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="XimTier">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ffffff">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# hreflang (PRD §FR-1 / FR-10) — 현재 경로 보존 %>
    <% path_no_locale = request.path.sub(%r{^/(ko|en)(?=/|$)}, "") %>
    <% path_no_locale = "" if path_no_locale == "/" %>
    <% I18n.available_locales.each do |loc| %>
      <link rel="alternate" hreflang="<%= loc %>" href="<%= request.base_url %>/<%= loc %><%= path_no_locale %>">
    <% end %>
    <link rel="alternate" hreflang="x-default" href="<%= request.base_url %><%= path_no_locale.presence || "/" %>">

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# JSON-LD 구조화 데이터 (SEO) %>
    <%= jsonld_script(organization_jsonld) %>
    <%= jsonld_script(website_jsonld) %>
    <%# 제품 엔티티를 검색엔진에 일관되게 전달하기 위해 전 페이지에 삽입 %>
    <%= jsonld_script(software_application_jsonld) %>
    <%= yield :jsonld %>

    <%# Plausible Analytics — ENV PLAUSIBLE_DOMAIN 설정 시만 활성 %>
    <% if ENV["PLAUSIBLE_DOMAIN"].present? %>
      <script defer data-domain="<%= ENV['PLAUSIBLE_DOMAIN'] %>" src="https://plausible.io/js/script.js"></script>
    <% end %>

    <% if ENV["GA4_MEASUREMENT_ID"].present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV['GA4_MEASUREMENT_ID'] %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= ENV["GA4_MEASUREMENT_ID"] %>', { 'anonymize_ip': true });
      </script>
    <% end %>

    <%# Meta 픽셀 — 유효한 ENV 설정 시만 활성 %>
    <% pixel_ids = meta_pixel_ids %>
    <% if pixel_ids.any? %>
      <script>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        <% pixel_ids.each do |pixel_id| %>
        fbq('init', '<%= pixel_id %>');
        <% end %>
        fbq('track', 'PageView');
      </script>
      <% pixel_ids.each do |pixel_id| %>
      <noscript><img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=<%= pixel_id %>&ev=PageView&noscript=1"
      ></noscript>
      <% end %>
    <% end %>

    <%# 네이버 서치어드바이저 소유확인 — ENV 설정 시만 활성 %>
    <% if ENV["NAVER_SITE_VERIFICATION"].present? %>
      <meta name="naver-site-verification" content="<%= ENV['NAVER_SITE_VERIFICATION'] %>">
    <% end %>
  </head>

  <body class="surface-canvas">
    <%= render "shared/brand_svg_defs" %>

    <% nav_links = [
         [t("v3nav.overview"),  v3_overview_path(locale: I18n.locale), false],
         [t("v3nav.data"),      v3_data_path(locale: I18n.locale), false],
         [t("v3nav.analysis"),  v3_analysis_path(locale: I18n.locale), false],
         [t("v3nav.solutions"), v3_solutions_path(locale: I18n.locale), false],
         [t("v3nav.usage"),     v3_usage_path(locale: I18n.locale), false],
         [t("v3nav.cases"),     case_studies_path(locale: I18n.locale), false],
         [t("v3nav.saas"),      ximtier_saas_url, true]
       ] %>
    <header class="nav-sticky" data-controller="nav-menu">
      <div class="wrap flex items-center justify-between" style="height:68px;">
        <%= link_to home_path(locale: I18n.locale), class: "no-underline" do %>
          <%= render BrandLogoComponent.new(variant: :light, size: 28) %>
        <% end %>

        <nav class="hidden md:flex items-center" style="gap:30px;">
          <% nav_links.each do |label, path, external| %>
            <%= link_to label, path, class: "type-body-sm text-body-airbnb hover:text-ink-airbnb transition", target: (external ? "_blank" : nil), rel: (external ? "noopener" : nil) %>
          <% end %>
        </nav>

        <div class="flex items-center" style="gap:10px;">
          <%# XimTier SaaS 분석 도구 로그인 연동 (XIMTIER_SAAS_URL 환경변수) %>
          <%= link_to t("site.nav.login", default: "로그인"), ximtier_saas_login_url, class: "btn-rausch", style: "padding:9px 18px;font-size:13px;min-height:auto;" %>
          <span class="hidden md:inline border-hairline-soft" style="height:14px;width:1px;"></span>
          <%= link_to "KO", home_path(locale: :ko), class: "text-[12px] font-semibold #{I18n.locale == :ko ? 'text-rausch' : 'text-muted-airbnb hover:text-ink-airbnb'} transition" %>
          <%= link_to "EN", home_path(locale: :en), class: "text-[12px] font-semibold #{I18n.locale == :en ? 'text-rausch' : 'text-muted-airbnb hover:text-ink-airbnb'} transition" %>

          <%# 모바일 햄버거 버튼 (md 미만에서만 노출) %>
          <button type="button" class="md:hidden inline-flex items-center justify-center"
                  style="width:38px;height:38px;margin-left:2px;color:var(--color-ink,#222);"
                  data-action="nav-menu#toggle" aria-label="메뉴 열기">
            <%= render IconComponent.new(name: "menu", size: 22) %>
          </button>
        </div>
      </div>

      <%# 모바일 드롭다운 패널 %>
      <nav class="md:hidden hidden border-t border-hairline" data-nav-menu-target="panel"
           style="background:var(--color-canvas,#fff);">
        <div class="wrap flex flex-col" style="padding:8px 0;">
          <% nav_links.each do |label, path, external| %>
            <%= link_to label, path,
                  class: "type-body-md text-ink-airbnb hover:text-rausch transition",
                  style: "padding:12px 4px;border-bottom:1px solid var(--color-hairline-soft,#ebebeb);",
                  target: (external ? "_blank" : nil), rel: (external ? "noopener" : nil) %>
          <% end %>
          <%= link_to t("site.nav.login", default: "로그인"), ximtier_saas_login_url,
                class: "type-body-md font-semibold text-rausch", style: "padding:14px 4px;" %>
        </div>
      </nav>
    </header>

    <main>
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/tweaks_panel" %>
    <%= render "shared/cookie_banner" %>

    <footer class="section-footer">
      <div class="wrap" style="padding-top:48px;padding-bottom:40px;">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div>
            <%= render BrandLogoComponent.new(variant: :dark, size: 28) %>
            <p class="mt-3 text-[13px]" style="color:#a7b1c7;max-width:520px;">
              <%= t("site.positioning") %> · <%= t("site.product_label") %>
            </p>
          </div>
          <div class="font-mono text-[12px]" style="color:#a7b1c7;">
            build / 2026.05 · <%= t("site.footer.copyright") %>
          </div>
        </div>
        <div class="mt-6 flex items-center gap-4 text-[12px]" style="color:#a7b1c7;">
          <%= link_to t("site.nav.why_not_llm"), why_not_llm_path(locale: I18n.locale), class: "hover:text-white transition" %>
          <%= link_to t("site.nav.how_it_works"), how_it_works_path(locale: I18n.locale), class: "hover:text-white transition" %>
        </div>
        <div class="mt-6 pt-4 text-[12px] leading-relaxed" style="color:#8892a6;border-top:1px solid rgba(167,177,199,0.15);">
          <%= t("site.footer.company_name") %> &nbsp;|&nbsp;
          <%= t("site.footer.ceo") %> &nbsp;|&nbsp;
          <%= t("site.footer.biz_no") %> &nbsp;|&nbsp;
          <%= t("site.footer.mail_order_no") %><br>
          <%= t("site.footer.address") %>
        </div>
      </div>
    </footer>
  </body>
</html>
